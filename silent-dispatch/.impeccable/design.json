      "css": ".ds-edition{display:flex;justify-content:space-between;gap:8px;color:var(--ink,#282820);border-top:3px double var(--ink,#282820);border-bottom:1px solid var(--ink,#282820);padding:8px 0 7px;font:11px/1.2 Georgia,serif;letter-spacing:.5px}"
