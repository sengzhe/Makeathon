      "css": ".ds-photo{display:block;width:100%;border:0;padding:0;background:var(--ink,#282820);cursor:pointer}.ds-enter{display:flex;flex-direction:column;align-items:center;gap:8px;color:#fff7e6;text-shadow:0 1px 3px #0008;font:11px/1.4 Georgia,serif;letter-spacing:2px;transition:transform .5s}.ds-enter svg{width:29px;height:29px;stroke:currentColor;fill:none;stroke-width:1}.ds-photo:hover .ds-enter{transform:translateY(-4px)}.ds-photo:focus-visible{outline:2px solid var(--ink,#282820);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-enter{transition:none}}"
